{
  "name": "voyage-voyage-rally",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:engine && npm run build:server && npm run build:client",
    "build:engine": "node node_modules/typescript/bin/tsc -p packages/engine/tsconfig.json",
    "build:server": "node node_modules/typescript/bin/tsc -p packages/server/tsconfig.json",
    "build:client": "node scripts/build-client.js",
    "test": "npm run build && node --test packages/engine/dist/engine.test.js",
    "start": "npm run build && node packages/server/dist/index.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
